# @file .env.example
# @brief Шаблон переменных окружения для nginx-ssl-project
# @author Тарасов С.Н.
# @date 2026-05-25
# @version 1.0.0

# === СЕТЬ И ПОРТЫ ===
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# === ПУТИ К СЕКРЕТАМ (относительно deploy/) ===
SSL_CERT_PATH=../certs/server.crt
SSL_KEY_PATH=../certs/server.key

# === СРЕДА ЗАПУСКА ===
APP_ENV=development
LOG_LEVEL=info
